{
  "name": "Deep Structure Mastering Studio",
  "short_name": "DS Studio",
  "description": "Audio-Editor und Mastering-Studio: EQ, Kompressor, Sättigung, Stereo, Limiter, LUFS-Messung, Referenz-Vergleich, WAV-Export.",
  "lang": "de",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0D0F13",
  "theme_color": "#0D0F13",
  "categories": ["music", "productivity"],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "file_handlers": [
    { "action": "./", "accept": { "audio/wav": [".wav"], "audio/x-wav": [".wav"], "audio/mpeg": [".mp3"], "audio/flac": [".flac"], "audio/mp4": [".m4a"] } }
  ]
}
